<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="GrawjiRecipeFolder" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="spacing">6</property>
    <child>
      <object class="GtkBox" id="header">
        <property name="spacing">6</property>
        <child>
          <object class="GtkButton" id="toggle_button">
            <property name="hexpand">true</property>
            <property name="halign">start</property>
            <style>
              <class name="flat"/>
              <class name="recipe-folder-toggle"/>
            </style>
            <property name="child">
              <object class="GtkBox">
                <property name="spacing">8</property>
                <child>
                  <object class="GtkImage" id="chevron">
                    <property name="icon-name">pan-down-symbolic</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="title_label">
                    <property name="xalign">0</property>
                    <property name="ellipsize">end</property>
                    <style>
                      <class name="heading"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="count_label">
                    <style>
                      <class name="dim-label"/>
                      <class name="caption"/>
                    </style>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="actions">
            <property name="valign">center</property>
            <property name="visible">false</property>
            <child>
              <object class="GtkButton" id="up_button">
                <property name="icon-name">go-up-symbolic</property>
                <property name="tooltip-text">Move the folder up</property>
                <style>
                  <class name="flat"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="down_button">
                <property name="icon-name">go-down-symbolic</property>
                <property name="tooltip-text">Move the folder down</property>
                <style>
                  <class name="flat"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkMenuButton" id="menu_button">
                <property name="icon-name">view-more-symbolic</property>
                <property name="tooltip-text">Folder actions</property>
                <style>
                  <class name="flat"/>
                </style>
                <property name="popover">
                  <object class="GtkPopover" id="menu_popover">
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">2</property>
                        <child>
                          <object class="GtkButton" id="rename_button">
                            <style>
                              <class name="flat"/>
                            </style>
                            <property name="child">
                              <object class="GtkLabel">
                                <property name="label">Rename Folder…</property>
                                <property name="xalign">0</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="delete_button">
                            <style>
                              <class name="flat"/>
                              <class name="destructive-action"/>
                            </style>
                            <property name="child">
                              <object class="GtkLabel">
                                <property name="label">Delete Folder</property>
                                <property name="xalign">0</property>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkListBox" id="rows">
        <property name="selection-mode">none</property>
        <style>
          <class name="boxed-list"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkDropTarget" id="drop_target">
        <property name="actions">move</property>
        <property name="formats">gchararray</property>
      </object>
    </child>
  </template>
</interface>
