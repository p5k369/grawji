<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="GrawjiCameraPane" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="width-request">340</property>
    <property name="hexpand">false</property>
    <property name="spacing">10</property>
    <property name="margin-start">16</property>
    <property name="margin-end">16</property>
    <property name="margin-top">16</property>
    <property name="margin-bottom">16</property>
    <child>
      <object class="GtkBox">
        <property name="spacing">12</property>
        <child>
          <object class="GtkImage" id="camera_image">
            <property name="pixel-size">36</property>
            <property name="icon-name">camera-photo-symbolic</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="camera_header">
            <property name="xalign">0</property>
            <property name="label">Camera</property>
            <property name="hexpand">true</property>
            <property name="ellipsize">end</property>
            <style>
              <class name="title-4"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="transfer_button">
            <property name="label">Transfer</property>
            <property name="tooltip-text">Write the assigned recipes and bank names into the camera</property>
            <property name="valign">center</property>
            <property name="visible">false</property>
            <style>
              <class name="suggested-action"/>
            </style>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkStack" id="camera_stack">
        <property name="vexpand">true</property>
        <child>
          <object class="GtkStackPage">
            <property name="name">banks</property>
            <property name="child">
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">never</property>
                <property name="vexpand">true</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <property name="margin-start">2</property>
                    <property name="margin-end">8</property>
                    <property name="margin-bottom">4</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="xalign">0</property>
                        <property name="label">Custom banks</property>
                        <style>
                          <class name="heading"/>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBox" id="bank_list">
                        <property name="selection-mode">none</property>
                        <style>
                          <class name="boxed-list"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="fs_section">
                        <property name="orientation">vertical</property>
                        <property name="spacing">8</property>
                        <property name="margin-top">6</property>
                        <property name="visible">false</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="xalign">0</property>
                            <property name="label">Film-simulation dial</property>
                            <style>
                              <class name="heading"/>
                              <class name="dim-label"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkListBox" id="fs_list">
                            <property name="selection-mode">none</property>
                            <style>
                              <class name="boxed-list"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBox" id="carrier_section">
                        <property name="selection-mode">none</property>
                        <property name="margin-top">10</property>
                        <style>
                          <class name="boxed-list"/>
                        </style>
                        <child>
                          <object class="AdwExpanderRow" id="carrier_expander">
                            <property name="title">Develop RAFs of other bodies</property>
                            <property name="title-lines">1</property>
                            <child>
                              <object class="GrawjiCarrierRow" id="carrier_row_100">
                                <property name="title">DR100</property>
                              </object>
                            </child>
                            <child>
                              <object class="GrawjiCarrierRow" id="carrier_row_200">
                                <property name="title">DR200</property>
                              </object>
                            </child>
                            <child>
                              <object class="GrawjiCarrierRow" id="carrier_row_400">
                                <property name="title">DR400</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkListBoxRow">
                                <property name="activatable">false</property>
                                <property name="child">
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">8</property>
                                    <property name="margin-top">10</property>
                                    <property name="margin-bottom">10</property>
                                    <property name="margin-start">12</property>
                                    <property name="margin-end">12</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="xalign">0</property>
                                        <property name="wrap">true</property>
                                        <property name="label">Lensless, uncompressed RAFs of this body, one per dynamic range. DR400 covers the rest.</property>
                                        <style>
                                          <class name="caption"/>
                                          <class name="dim-label"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="carrier_problem">
                                        <property name="xalign">0</property>
                                        <property name="wrap">true</property>
                                        <property name="visible">false</property>
                                        <style>
                                          <class name="caption"/>
                                          <class name="error"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="spacing">6</property>
                                        <child>
                                          <object class="GtkButton" id="carrier_add_button">
                                            <property name="label">Add carrier…</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="carrier_current_button">
                                            <property name="label">Use current image</property>
                                            <property name="visible">false</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">none</property>
            <property name="child">
              <object class="AdwStatusPage" id="camera_none_page">
                <property name="icon-name">camera-photo-symbolic</property>
                <property name="title">No camera</property>
                <property name="description">Connect a body in USB RAW CONV./BACKUP RESTORE mode to assign recipes to its banks.</property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
