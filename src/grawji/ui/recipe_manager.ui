<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="GrawjiRecipeManagerDialog" parent="AdwDialog">
    <property name="title">Manage recipes</property>
    <property name="content-width">1180</property>
    <property name="content-height">880</property>
    <property name="child">
      <object class="AdwToastOverlay" id="toasts">
      <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <child type="start">
              <object class="GtkSearchEntry" id="search_entry">
                <property name="placeholder-text">Search recipes</property>
                <property name="tooltip-text">Filter recipes by name, comment or film simulation (Ctrl+F)</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkToggleButton" id="tryout_button">
                <property name="label">Try on image</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkSpinner" id="tryout_spinner">
                <property name="visible">false</property>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <child>
              <object class="GtkBox" id="list_pane">
                <property name="orientation">vertical</property>
                <property name="hexpand">true</property>
                <child>
                  <object class="GtkBox">
                    <property name="spacing">6</property>
                    <property name="margin-start">16</property>
                    <property name="margin-end">16</property>
                    <property name="margin-top">12</property>
                    <property name="margin-bottom">4</property>
                    <child>
                      <object class="GtkMenuButton" id="import_button">
                        <property name="label">Import</property>
                        <property name="tooltip-text">Add recipes to the library</property>
                        <property name="popover">
                          <object class="GtkPopover" id="import_popover">
                            <property name="child">
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">2</property>
                                <child>
                                  <object class="GtkButton" id="import_files_button">
                                    <style>
                                      <class name="flat"/>
                                    </style>
                                    <property name="child">
                                      <object class="GtkLabel">
                                        <property name="label">Recipe files or photos…</property>
                                        <property name="xalign">0</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="import_folder_button">
                                    <style>
                                      <class name="flat"/>
                                    </style>
                                    <property name="child">
                                      <object class="GtkLabel">
                                        <property name="label">A folder of recipes…</property>
                                        <property name="xalign">0</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="import_clipboard_button">
                                    <style>
                                      <class name="flat"/>
                                    </style>
                                    <property name="child">
                                      <object class="GtkLabel">
                                        <property name="label">Recipe text from the clipboard</property>
                                        <property name="xalign">0</property>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="new_folder_button">
                        <property name="icon-name">folder-new-symbolic</property>
                        <property name="tooltip-text">New folder</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="pictures_button">
                        <property name="visible">false</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="selection_label">
                        <property name="hexpand">true</property>
                        <property name="xalign">1</property>
                        <property name="ellipsize">end</property>
                        <style>
                          <class name="dim-label"/>
                          <class name="caption"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="bulk_box">
                        <property name="spacing">6</property>
                        <property name="visible">false</property>
                    <child>
                      <object class="GtkMenuButton" id="move_button">
                        <property name="label">Move to</property>
                        <property name="sensitive">false</property>
                        <property name="tooltip-text">Move the selected recipes into a folder</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="export_button">
                        <property name="label">Export</property>
                        <property name="sensitive">false</property>
                        <property name="tooltip-text">Write the selected recipes as X RAW Studio files</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="delete_button">
                        <property name="icon-name">user-trash-symbolic</property>
                        <property name="sensitive">false</property>
                        <property name="tooltip-text">Delete the selected recipes</property>
                      </object>
                    </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkStack" id="stack">
                    <property name="vexpand">true</property>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">list</property>
                        <property name="child">
                          <object class="GtkScrolledWindow" id="list_scroll">
                            <property name="hscrollbar-policy">never</property>
                            <property name="vexpand">true</property>
                            <property name="child">
                              <object class="GtkBox" id="content">
                                <property name="orientation">vertical</property>
                                <property name="spacing">18</property>
                                <property name="margin-start">16</property>
                                <property name="margin-end">16</property>
                                <property name="margin-top">8</property>
                                <property name="margin-bottom">16</property>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">nomatch</property>
                        <property name="child">
                          <object class="AdwStatusPage">
                            <property name="icon-name">edit-find-symbolic</property>
                            <property name="title">No recipes match</property>
                            <property name="description">Try another name, comment or film simulation.</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">empty</property>
                        <property name="child">
                          <object class="AdwStatusPage">
                            <property name="icon-name">emblem-documents-symbolic</property>
                            <property name="title">No recipes</property>
                            <property name="description">Import recipes with the button above, or save the current settings in the main window.</property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkSeparator">
                <property name="orientation">vertical</property>
              </object>
            </child>
            <child>
              <object class="GtkStack" id="side_stack">
                <property name="hhomogeneous">false</property>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">manage</property>
                    <property name="child">
                      <object class="GtkBox">
                        <child>
                          <object class="GrawjiRecipeDetails" id="details"/>
                        </child>
                        <child>
                          <object class="GtkSeparator">
                            <property name="orientation">vertical</property>
                          </object>
                        </child>
                        <child>
                          <object class="GrawjiCameraPane" id="camera_pane"/>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">tryout</property>
                    <property name="child">
                      <object class="GtkStack" id="tryout_stack">
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">none</property>
                            <property name="child">
                              <object class="AdwStatusPage">
                                <property name="icon-name">image-x-generic-symbolic</property>
                                <property name="title">Select recipes to try</property>
                                <property name="description">Each selected recipe is shown on the open image. Ctrl and Shift select several, Ctrl+A selects all.</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">cards</property>
                            <property name="child">
                              <object class="GtkScrolledWindow" id="tryout_scroll">
                                <property name="hscrollbar-policy">never</property>
                                <property name="vexpand">true</property>
                                <property name="child">
                                  <object class="GtkFlowBox" id="tryout_grid">
                                    <property name="selection-mode">none</property>
                                    <property name="max-children-per-line">8</property>
                                    <property name="row-spacing">6</property>
                                    <property name="column-spacing">6</property>
                                    <property name="margin-start">10</property>
                                    <property name="margin-end">10</property>
                                    <property name="margin-top">12</property>
                                    <property name="margin-bottom">16</property>
                                    <property name="valign">start</property>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
      </property>
      </object>
    </property>
  </template>
</interface>
